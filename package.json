{
  "name": "claude-multi",
  "version": "2.3.0",
  "description": "Multi AI launcher: Claude accounts, ChatGPT, Gemini and more with saved logins",
  "author": "Claude Multi",
  "main": "boot.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.claudemulti",
    "productName": "Claude Multi",
    "files": [
      "boot.js",
      "main.js",
      "preload.js",
      "webauthn-off.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}